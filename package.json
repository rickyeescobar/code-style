{
  "name": "@r1-dev/code-style",
  "version": "0.1.1",
  "description": "Opinionated oxlint and oxfmt configuration: a base config, a React add-on, a blank-line rule, and the formatter options.",
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "eslint-plugin",
    "lint",
    "format",
    "code-style"
  ],
  "license": "MIT",
  "author": "Ricardo Escobar",
  "repository": "github:rickyeescobar/code-style",
  "homepage": "https://github.com/rickyeescobar/code-style#readme",
  "bugs": "https://github.com/rickyeescobar/code-style/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./padding-lines": {
      "types": "./dist/padding-lines.d.ts",
      "default": "./dist/padding-lines.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.83.0"
  },
  "peerDependencies": {
    "oxfmt": ">=0.68.0",
    "oxlint": ">=1.83.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
